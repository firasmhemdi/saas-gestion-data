# Application
APP_NAME=SaaS Gestion Data API
API_V1_PREFIX=/api/v1

# Base de données production
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/DB_NAME
DB_ECHO=false

# Sécurité API
CORS_ALLOWED_ORIGINS=https://votre-frontend.com
JWT_SECRET_KEY=CHANGE_ME_generate_a_long_random_secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
BCRYPT_ROUNDS=12

# OTP par e-mail
OTP_ENABLED=true
OTP_EXPIRE_MINUTES=5
OTP_LENGTH=6
OTP_MAX_ATTEMPTS=5
EMAIL_VERIFICATION_REQUIRED=true
DEMO_MODE=false
OTP_EXPOSE_DEMO_CODE=false

# Provider e-mail : utiliser resend ou mailjet sur Render Free, smtp sur un hébergement qui autorise SMTP.
# Sans domaine vérifié, Resend limite les destinataires de test.
# Pour une application publique, utilisez un expéditeur d'un domaine vérifié.
EMAIL_PROVIDER=resend
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxx
RESEND_FROM_EMAIL=onboarding@resend.dev

# Mailjet API : option utile sans domaine, après validation d'une adresse expéditeur.
MAILJET_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
MAILJET_SECRET_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
MAILJET_FROM_EMAIL=votre.email@gmail.com
MAILJET_FROM_NAME=SaaS Gestion Data

# SMTP Gmail: utiliser un mot de passe d'application, jamais le mot de passe Gmail normal
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=votre.email@gmail.com
SMTP_PASSWORD=votre_mot_de_passe_application_gmail
SMTP_FROM_EMAIL=votre.email@gmail.com
SMTP_FROM_NAME=SaaS Gestion Data
SMTP_USE_TLS=true

# Chiffrement local des données sensibles
DATA_ENCRYPTION_KEY=CHANGE_ME_generate_a_long_random_secret
