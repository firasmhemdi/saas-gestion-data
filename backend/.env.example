# Application
APP_NAME=SaaS Gestion Data API
API_V1_PREFIX=/api/v1

# PostgreSQL (port 5433 pour éviter tout conflit avec une instance locale sur 5432)
DATABASE_URL=postgresql+psycopg://saas:saas@localhost:5433/saas_gestion_data

# Frontend autorisé à appeler l'API.
# En production, remplacer par l'URL HTTPS réelle du frontend.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# JWT - MUST be changed in production
JWT_SECRET_KEY=CHANGE_ME_production_secret_key_at_least_32_chars
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# OTP (double authentification)
OTP_ENABLED=true
OTP_EXPIRE_MINUTES=5
OTP_LENGTH=6
OTP_MAX_ATTEMPTS=5
EMAIL_VERIFICATION_REQUIRED=true
# En mode réel, le code OTP est envoyé par e-mail via SMTP.
# En production : DEMO_MODE=false et OTP_EXPOSE_DEMO_CODE=false.
DEMO_MODE=true
# Ne jamais activer en production. Réservé aux tests automatisés.
OTP_EXPOSE_DEMO_CODE=false

# Provider e-mail : smtp ou resend.
# Render Free bloque souvent les ports SMTP ; utiliser resend en production gratuite.
# Avec Resend sans domaine vérifié, onboarding@resend.dev sert surtout aux tests.
# Pour envoyer à tous les utilisateurs, configurez un domaine vérifié dans RESEND_FROM_EMAIL.
EMAIL_PROVIDER=smtp
RESEND_API_KEY=
RESEND_FROM_EMAIL=onboarding@resend.dev

# Envoi e-mail OTP avec Gmail SMTP
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=votre.email@gmail.com
SMTP_PASSWORD=votre_mot_de_passe_application_gmail
SMTP_FROM_EMAIL=votre.email@gmail.com
SMTP_FROM_NAME=SaaS Gestion Data
SMTP_USE_TLS=true

# Chiffrement AES-256 au repos des données sensibles (identifiants des connecteurs...)
DATA_ENCRYPTION_KEY=CHANGE_ME_production_encryption_key_at_least_32_chars
