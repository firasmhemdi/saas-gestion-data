# Variables utilisées par docker-compose.prod.yml
POSTGRES_USER=saas_prod
POSTGRES_PASSWORD=CHANGE_ME_generate_a_database_password
POSTGRES_DB=saas_gestion_data

APP_NAME=SaaS Gestion Data API
CORS_ALLOWED_ORIGINS=https://votre-frontend.com
NEXT_PUBLIC_API_URL=https://votre-backend.com/api/v1

JWT_SECRET_KEY=CHANGE_ME_generate_a_long_random_secret
DATA_ENCRYPTION_KEY=CHANGE_ME_generate_a_long_random_secret

ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
OTP_ENABLED=true
OTP_EXPIRE_MINUTES=5
OTP_LENGTH=6
OTP_MAX_ATTEMPTS=5
EMAIL_VERIFICATION_REQUIRED=true

EMAIL_PROVIDER=resend
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxx
RESEND_FROM_EMAIL=onboarding@resend.dev

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=votre.email@gmail.com
SMTP_PASSWORD=votre_mot_de_passe_application_gmail
SMTP_FROM_EMAIL=votre.email@gmail.com
SMTP_FROM_NAME=SaaS Gestion Data
SMTP_USE_TLS=true
